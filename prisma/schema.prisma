generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id                 String   @id @default(cuid())
  schoolNumber       Int      @unique @default(autoincrement())
  name               String
  address            String?
  phone              String?
  email              String?
  logoUrl            String?
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())

  users          User[]
  coursePackages CoursePackage[]
  students       Student[]
  instructors    Instructor[]
  vehicles       Vehicle[]
  lessons        Lesson[]
  payments       Payment[]
}

model User {
  id             String   @id @default(cuid())
  schoolId       String
  fullName       String
  email          String   @unique
  phone          String?
  referralSource String?
  passwordHash   String
  role           Role
  isOnboarded    Boolean  @default(false)
  isSetupComplete Boolean @default(false)
  createdAt      DateTime @default(now())

  school     School      @relation(fields: [schoolId], references: [id])
  instructor Instructor?

  @@index([schoolId])
}

enum Role {
  SUPER_ADMIN
  STAFF
  INSTRUCTOR
}

model CoursePackage {
  id              String   @id @default(cuid())
  schoolId        String
  name            String
  totalLessons    Int
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @default(60)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id])
  students Student[]

  @@index([schoolId])
}

model Student {
  id               String         @id @default(cuid())
  schoolId         String
  studentCode      String         @unique
  fullName         String
  phone            String
  email            String?
  address          String?
  photoUrl         String?
  coursePackageId  String?
  loginToken       String         @unique @default(cuid())
  paymentStatus    PaymentStatus  @default(UNPAID)
  progressStatus   ProgressStatus @default(ACTIVE)
  lessonsCompleted Int            @default(0)
  createdAt        DateTime       @default(now())

  school        School         @relation(fields: [schoolId], references: [id])
  coursePackage CoursePackage? @relation(fields: [coursePackageId], references: [id])
  lessons       Lesson[]
  payments      Payment[]

  @@index([schoolId])
  @@index([loginToken])
}

enum PaymentStatus {
  UNPAID
  PART_PAID
  FULLY_PAID
}

enum ProgressStatus {
  ACTIVE
  READY_FOR_TEST
  CERTIFICATE_ISSUED
}

model Instructor {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?  @unique
  fullName  String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  school   School             @relation(fields: [schoolId], references: [id])
  user     User?              @relation(fields: [userId], references: [id])
  lessons  Lesson[]
  vehicles InstructorVehicle[]

  @@index([schoolId])
}

model Vehicle {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  type      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  school      School              @relation(fields: [schoolId], references: [id])
  lessons     Lesson[]
  instructors InstructorVehicle[]

  @@index([schoolId])
}

model InstructorVehicle {
  instructorId String
  vehicleId    String

  instructor Instructor @relation(fields: [instructorId], references: [id])
  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id])

  @@id([instructorId, vehicleId])
}

model Lesson {
  id              String       @id @default(cuid())
  schoolId        String
  studentId       String
  instructorId    String?
  vehicleId       String?
  scheduledDate   DateTime
  durationMinutes Int          @default(60)
  status          LessonStatus @default(SCHEDULED)
  checkedInAt     DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime     @default(now())

  school     School      @relation(fields: [schoolId], references: [id])
  student    Student     @relation(fields: [studentId], references: [id])
  instructor Instructor? @relation(fields: [instructorId], references: [id])
  vehicle    Vehicle?    @relation(fields: [vehicleId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([instructorId])
  @@index([scheduledDate])
}

enum LessonStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  MISSED
  RESCHEDULED
}

model Payment {
  id          String        @id @default(cuid())
  schoolId    String
  studentId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  paymentDate DateTime
  receiptUrl  String?
  notes       String?
  voided      Boolean       @default(false)
  voidedAt    DateTime?
  voidedBy    String?
  createdAt   DateTime      @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([studentId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
}